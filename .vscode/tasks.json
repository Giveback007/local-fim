{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "dependsOrder": "sequence",
      "dependsOn": ["build:compile", "build:move-host"],
      "problemMatcher": []
    },
    {
      "label": "build:compile",
      "type": "shell",
      "command": "pnpm run build",
      "problemMatcher": []
    },
    {
      "label": "build:move-host",
      "type": "shell",
      "command": "setsid -f sh -c 'sleep 2 && ~/Documents/local-fim/.vscode/move-dev-host.sh' </dev/null >/dev/null 2>&1",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "line": 1, "message": 1 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "."
        }
      }
    }
  ]
}
